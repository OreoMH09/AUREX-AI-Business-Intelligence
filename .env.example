# AUREX Environment Configuration

# Application
APP_NAME=AUREX
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Streamlit
STREAMLIT_PORT=8501

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Database
VECTOR_DB=chromadb
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=aurex_documents

# Retrieval
TOP_K=3
SIMILARITY_THRESHOLD=0.8
ENABLE_RERANKING=false

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,xlsx,xls,csv
UPLOAD_DIR=./data/raw

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/aurex.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aurex.log

# Analytics
ENABLE_ANALYTICS=true
ENABLE_VISUALIZATION=true

# Agent
MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=90

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000

# OCR (Optional)
TESSERACT_PATH=/usr/bin/tesseract
ENABLE_OCR=false
